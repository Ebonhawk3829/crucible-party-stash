<div class="stash-currency-section">
  <div class="stash-currency-pool">
    {{#if shapedCurrency}}
      {{#each currencyConfig}}
        <span class="stash-denom-chip" data-tooltip="{{localize this.label}}">
          {{#if this.icon}}<img class="denom-icon" src="{{this.icon}}" alt="{{localize this.abbreviation}}">{{/if}}
          <span class="denom-count">{{lookup ../pool @key}}</span>
        </span>
      {{/each}}
    {{else}}
      <i class="fa-solid fa-coins"></i>
      <span class="stash-currency-amount">{{formatCurrency pool}}</span>
    {{/if}}
  </div>
  {{#if isEditable}}
  <div class="controls">
    <a class="control" data-stash-action="currencyDeposit"
       data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.DepositCurrencyTitle"}}"
       aria-label="{{localize "CRUCIBLE_PARTY_STASH.DepositCurrencyTitle"}}">
      <i class="fa-solid fa-arrow-up-from-bracket"></i>
    </a>
    <a class="control" data-stash-action="currencyTake"
       data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.TakeCurrencyTitle"}}"
       aria-label="{{localize "CRUCIBLE_PARTY_STASH.TakeCurrencyTitle"}}">
      <i class="fa-solid fa-hand-holding-dollar"></i>
    </a>
    {{#if isGM}}
    <a class="control" data-stash-action="currencyCreate"
       data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.CreateCurrencyTitle"}}"
       aria-label="{{localize "CRUCIBLE_PARTY_STASH.CreateCurrencyTitle"}}">
      <i class="fa-solid fa-plus"></i>
    </a>
    {{#if shapedCurrency}}
    <a class="control" data-stash-action="currencyExchange"
       data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.ExchangeTitle"}}"
       aria-label="{{localize "CRUCIBLE_PARTY_STASH.ExchangeTitle"}}">
      <i class="fa-solid fa-right-left"></i>
    </a>
    {{/if}}
    <a class="control" data-stash-action="currencySplit"
       data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.SplitCurrencyTitle"}}"
       aria-label="{{localize "CRUCIBLE_PARTY_STASH.SplitCurrencyTitle"}}">
      <i class="fa-solid fa-coins"></i>
    </a>
    {{/if}}
  </div>
  {{/if}}
</div>
{{#if isEmpty}}
<div class="stash-empty">
  <p><i class="fa-solid fa-box-open"></i> {{localize "CRUCIBLE_PARTY_STASH.StashEmpty"}}</p>
  <p class="hint">{{localize "CRUCIBLE_PARTY_STASH.DragHint"}}</p>
</div>
{{else}}
<div class="stash-container">
  <p class="hint">{{localize "CRUCIBLE_PARTY_STASH.DragHintStash"}}</p>
  <ol class="items-list stash-list scrollable">
    {{#each items}}
    <li class="stash-item line-item" data-stash-id="{{this._stashId}}" draggable="true">
      <div class="stash-tooltip-zone">
        <img class="icon" src="{{this.img}}" alt="{{this.name}}" width="32" height="32">
        <div class="title">
          <h4>{{this.name}}</h4>
          <span class="tag">{{this.typeLabel}}</span>
          {{#if this.system.quantity}}
            <span class="tag">{{localize "CRUCIBLE_PARTY_STASH.Quantity"}}: {{this.system.quantity}}</span>
          {{/if}}
        </div>
      </div>
      {{#if ../isEditable}}
      <div class="controls">
        {{#if this.isStackable}}
        <a class="control" data-stash-action="editQty" data-stash-id="{{this._stashId}}"
           data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.EditQuantityTitle"}}"
           aria-label="{{localize "CRUCIBLE_PARTY_STASH.EditQuantityTitle"}}">
          <i class="fa-solid fa-pen"></i>
        </a>
        {{/if}}
        <a class="control" data-stash-action="give" data-stash-id="{{this._stashId}}"
           data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.GiveToCharacter"}}"
           aria-label="{{localize "CRUCIBLE_PARTY_STASH.GiveToCharacter"}}">
          <i class="fa-solid fa-hand-holding"></i>
        </a>
        <a class="control" data-stash-action="remove" data-stash-id="{{this._stashId}}"
           data-tooltip="{{localize "CRUCIBLE_PARTY_STASH.RemoveFromStash"}}"
           aria-label="{{localize "CRUCIBLE_PARTY_STASH.RemoveFromStash"}}">
          <i class="fa-solid fa-trash"></i>
        </a>
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ol>
</div>
{{/if}}